# CertPilot Backend - environment configuration
# Leave all values empty to run in SIMULATION MODE (no LLM calls, deterministic
# data-grounded responses). CertPilot is fully functional without any keys.

# Option A: GitHub Models (used by the original starter kit)
GITHUB_TOKEN=

# Option B: Azure OpenAI / Microsoft Foundry
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT=gpt-4o
